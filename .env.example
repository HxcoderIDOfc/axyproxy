# ==========================================
# Axynera API Proxy - Environment Variables
# ==========================================

# [WAJIB] Kunci API 9Router / Nextura upstream kamu
NINEROUTER_KEY=sk-your-9router-api-key-here

# [OPSIONAL] URL Upstream 9Router (sudah ada default jika dikosongkan)
NINEROUTER_URL=https://router.nextura.my.id/v1/chat/completions
NINEROUTER_COMPLETIONS_URL=https://router.nextura.my.id/v1/completions
NINEROUTER_URL_ANTHROPIC=https://router.nextura.my.id/v1/messages
NINEROUTER_IMAGE_URL=https://router.nextura.my.id/v1/images/generations
